# ============================================
# SUPABASE CONFIGURATION EXAMPLE
# Portal Berita - PostgreSQL Configuration
# ============================================

# Laravel Configuration
APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:qhFhY4rnMp/YS5PvqAHFCUp0YWEnaeXIDEyfOmPeL/8=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# SUPABASE DATABASE CONNECTION
# ============================================
DB_CONNECTION=pgsql
DB_HOST=db.alpivotfqqqsjhdovlrj.supabase.co
DB_PORT=6543                              # Connection Pooling Port (recommended)
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_PASSWORD_HERE   # ⚠️ GANTI DENGAN PASSWORD ANDA
DB_SCHEMA=portal_berita                    # Custom schema name

# ============================================
# SUPABASE API (for Frontend)
# ============================================
SUPABASE_URL=https://alpivotfqqqsjhdovlrj.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFscGl2b3RmcXFxc2poZG92bHJqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzA2MDgxNzksImV4cCI6MjA4NjE4NDE3OX0.tnbqAkJSHJ1IF597D2PpfY3X2DmBFXZbX_frW5qZpck
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_HERE  # Optional: untuk admin operations

# ============================================
# CACHE & SESSION
# ============================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ============================================
# REDIS (Optional)
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# MAIL CONFIGURATION
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# VITE (Frontend Build)
# ============================================
VITE_APP_NAME="${APP_NAME}"
VITE_SUPABASE_URL="${SUPABASE_URL}"
VITE_SUPABASE_ANON_KEY="${SUPABASE_ANON_KEY}"

# ============================================
# NOTES:
# ============================================
# 1. Port 6543 = Connection Pooling (recommended untuk production)
# 2. Port 5432 = Direct Connection (untuk development/migration)
# 3. DB_SCHEMA = Custom schema di Supabase (bukan 'public')
# 4. ANON_KEY = Public key, aman untuk frontend
# 5. SERVICE_KEY = Private key, JANGAN expose ke frontend!
